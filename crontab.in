# Crontab template for every machine. Install it with `dotfiles-cron --install`,
# never with `crontab` directly: dotfiles-cron fills in the {{...}} placeholders
# for this machine and keeps lines prefixed with `macos:` or `linux:` only on
# that OS. Scripts run from cron cannot have a .* extension (no .sh), or they
# fail to run. todo and vault-sync come from vault-tools (uv tool install, in
# ~/.local/bin).
#
# The Macs share the vault through iCloud, so the task jobs and vault-sync run
# only on the Mac that has ~/.vault-owner (`touch ~/.vault-owner` on exactly one
# Mac); the OWNER placeholder is that test on macOS and empty on Linux. Running
# them on two Macs would process done.md twice and run git on a .git directory
# that iCloud is syncing. Fedora has no task jobs: vault-sync processes the
# tasks itself after pulling (todo collect + todo done), and the vault owner's
# backups cover the shared todo.md.

PATH={{PATH}}
VAULT="{{VAULT}}"

macos:# Daily APOD wallpaper (~/.APOD_Mac_Daily is not in the dotfiles)
macos:0 10 * * * test -x ~/.APOD_Mac_Daily/apod_daily && ~/.APOD_Mac_Daily/apod_daily

macos:# Back up todo.md and active.md (rolling, keeps last 10 copies each)
macos:0 9 * * * {{OWNER}}todo backup

macos:# Move done tasks to done.md
macos:0 10 * * * {{OWNER}}todo done
macos:0 18 * * * {{OWNER}}todo done

# Share 0-tasks, 0-zettelkasten and templates through GitHub, hourly: at :05 on
# the Mac (clear of the todo jobs) and :35 on Fedora, so they never push at the
# same minute
macos:5 * * * * {{OWNER}}vault-sync --auto >> /tmp/vault-sync.log 2>&1
linux:35 * * * * vault-sync --auto >> /tmp/vault-sync.log 2>&1
@reboot sleep 60 && {{OWNER}}vault-sync --auto >> /tmp/vault-sync.log 2>&1

# Repositories with unsynced work: refresh the cache for tmux and new shells,
# and notify at the usual ends of the day
*/15 * * * * {{BASH}} {{SCRIPTS}}/repos --check
0 16,18 * * * {{BASH}} {{SCRIPTS}}/repos --notify
