# dotfiles git repo
alias dotfiles="cd $HOME/.dotfiles && ls -la && git status"
alias doftiles="dotfiles"
alias dot="ls ~/.dotfiles -la && git status ~/.dotfiles"

alias lg="lazygit"

# git
alias gp="git pull"
alias gP="git push"
alias s="git status"

# git custom scripts
alias com="commit"
alias pu="push"

# Shortcuts
alias v="vi"
alias za="zathura"
alias zat="zathura"
alias c="clear"
alias q="exit"

# Vim
alias zshrc="vim ~/.zshrc && source ~/.zshrc"
alias aliasrc="vim ~/.config/.aliasrc && source ~/.config/.aliasrc"
alias nvimrc="vim ~/.config/nvim/init.lua"
alias vimrc="vim ~/.vimrc"
alias vsplit="vim -O"

# tmux
alias tm="tmux"
alias tma="tmux a"
alias tms="tmux ls"

# Vault and task system
alias vimwiki="cd $VAULT && nvim -c ':VimwikiIndex'"
alias wiki="vimwiki"
alias idea="zet idea"

# `todo` (scripts/todo) opens the list when run without a subcommand
alias pomo="todo-pomodoro"
alias p="todo-pomodoro"
alias pp="todo-pomodoro 2"

alias rga="rg -."

# List the most used commands in zsh history
alias freq='cut -f2 -d";" $HISTFILE | sort | uniq -c | sort -nr | head -n 30'

# Verbosity and settings that you pretty much just always are going to want.
alias \
	cp="cp -iv" \
	mv="mv -iv" \
	rm="rm -vI" \
	bc="bc -ql" \
	mkd="mkdir -pv" \
	ffmpeg="ffmpeg -hide_banner"

# Colorize commands when possible.
alias \
	ls="ls -hN --color=auto --group-directories-first" \
	ll="ls -la" \
	l="ll" \
	ltr="ls -ltr -hN --color=auto --group-directories-first" \
	l.="ls -d .* --color=auto" \
        sl="ls" \
	grep="grep --color=auto" \
	diff="diff --color=auto"

# Replace ls with eza if available
if [ -x "$(command -v eza)" ]; then
    alias ls="eza --icons=auto"
    alias la="eza --long --all --group --icons=auto"
    alias ltr="ls -l -snew --group-directories-first --icons=auto"
fi

# Utilities
alias weather='curl wttr.in'
alias dush='du -shc --apparent-size'
alias greph='history | grep'
alias fzfh='history | fzf'

# Replace top by htop if available
if [ -x "$(command -v htop)" ]; then
    alias top="htop"
fi


# jupyter notebooks
alias jn='jupyter-notebook'
alias jlab='jupyter-lab'

# remote work
alias c8='ssh cosma8a'
alias c8b='ssh cosma8b'
alias jtunnel='ssh -N -L 8443:login8b.cosma.dur.ac.uk:443 dc-barr3@login8b.cosma.dur.ac.uk'

# ── Functions (zsh) ──────────────────────────────────────────────────────────

# Visualises PDF files in the terminal.
# Uses timg if inside a TMUX sesion, otherwise uses pdftoppm and wezterm's imgcat.

pdfview() {
  if [ -n "$TMUX" ]; then
    timg --title "$@"
  else
    pdftoppm -r 150 "$1" /tmp/pdfpreview
    for img in /tmp/pdfpreview-*.ppm; do
      wezterm imgcat "$img"
    done
    command rm -f /tmp/pdfpreview-*.ppm
  fi
}

# Removes (temp) files with specific extensions in target directory

cleanuptmp() {
  local extensions=("aux" "bbl" "out" "log" "blg" "synctex.gz" "fls" "fdb_latexmk" \
      "bak" ".o")

  if (( $# == 0 )); then
    local directory=./
  else
    local directory=$1"/"
  fi

  local files_found=false

  for ext in "${extensions[@]}"; do
    local matching_files=($directory*.$ext(N))
    if (( ${#matching_files} > 0 )); then
      files_found=true
      rm -f $matching_files
    fi
  done

  if $files_found; then
    echo "Done removing temp files."
  else
    echo "No temp files found."
  fi
}
