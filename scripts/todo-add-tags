#!/opt/homebrew/bin/bash  # Apple Silicon (M1/M2)

TODO_FILE="$VAULT/0-tasks/todo.md"
TAG_CONFIG="$HOME/.dotfiles/scripts/task-tags.conf"
TEMP_FILE="/tmp/tagged_tasks.txt"

# Load keyword → tag mappings from external file
declare -A TAG_MAP
while IFS=":" read -r tag pattern; do
    [[ -z "$tag" || "$tag" =~ ^# ]] && continue  # Skip empty lines & comments
    pattern=$(echo "$pattern" | xargs)  # Trim spaces from the regex pattern
    TAG_MAP["$tag"]="$pattern"
done < "$TAG_CONFIG"

TASKS_FOUND=false
> "$TEMP_FILE"  # Truncate before writing

# Single-pass: write every line as-is, except task lines which get tags applied
while IFS= read -r LINE; do
    if [[ "$LINE" =~ ^-[[:space:]] ]]; then
        TASKS_FOUND=true
        TASK_TEXT=$(echo "$LINE" | sed -E 's/- \[[!> x]\] //')  # Remove checkbox
        TASK_TEXT_LOWER=$(echo "$TASK_TEXT" | tr '[:upper:]' '[:lower:]')

        # Extract existing tags and seed the array
        unset TAGS_ARRAY
        declare -A TAGS_ARRAY
        while IFS= read -r existing_tag; do
            [[ -n "$existing_tag" ]] && TAGS_ARRAY["$existing_tag"]=1
        done < <(echo "$LINE" | rg -o '@[a-zA-Z0-9_-]+')

        echo "🔍 Processing task: $TASK_TEXT"

        # Add tags whose pattern matches the task text
        for tag in "${!TAG_MAP[@]}"; do
            if echo "$TASK_TEXT_LOWER" | rg -i -q -- "${TAG_MAP[$tag]}"; then
                TAGS_ARRAY["$tag"]=1
            fi
        done

        # Validate: keep only tags that still match (or were manually added and have no mapping)
        VALID_TAGS=()
        for tag in "${!TAGS_ARRAY[@]}"; do
            if [[ -n "${TAG_MAP[$tag]}" ]]; then
                echo "$TASK_TEXT_LOWER" | rg -i -q -- "${TAG_MAP[$tag]}" && VALID_TAGS+=("$tag")
            else
                VALID_TAGS+=("$tag")  # Preserve manually added tags with no config entry
            fi
        done

        FINAL_TAGS=$(printf '%s\n' "${VALID_TAGS[@]}" | sort -u | tr '\n' ' ' | xargs)

        # Strip existing tags from line then append the validated set
        UPDATED_TASK="$(echo "$LINE" | sed -E 's/ ?@[a-zA-Z0-9_-]+//g' | xargs)"
        [[ -n "$FINAL_TAGS" ]] && UPDATED_TASK="$UPDATED_TASK $FINAL_TAGS"
        echo "$UPDATED_TASK" >> "$TEMP_FILE"
    else
        echo "$LINE" >> "$TEMP_FILE"
    fi
done < "$TODO_FILE"

# Replace the original TODO file if tasks were found
if $TASKS_FOUND; then
    mv "$TEMP_FILE" "$TODO_FILE"
    echo "✅ Tasks updated with tags in $TODO_FILE"
else
    rm -f "$TEMP_FILE"
    echo "ℹ️  No task lines found in $TODO_FILE"
fi
