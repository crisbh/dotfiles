#!/usr/bin/env bash
#
# zet: open or create a note in the vault's zettelkasten.
#
#   zet          pick a note with fzf; typing a name that matches nothing and
#                pressing Enter creates that note
#   zet <name>   open <name>.md, creating it if needed (name without .md)

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac
[[ $# -le 1 ]] || die "Please provide only one filename (without .md extension). Example: zet my-new-note"

require_vault

# Create the note with an Obsidian header and open it at the bottom; open it
# as-is if it already exists
open_file() {
  local filename=$1 file_path="$ZET_DIR/$1.md"

  if [[ -f "$file_path" ]]; then
    echo "Opening existing note: $filename.md"
    exec nvim "$file_path"
  fi

  mkdir -p "$ZET_DIR"
  cat >"$file_path" <<EOF
---
id: $filename
aliases:
  - $filename
tags:
  - $filename
  - $(date +"%Y")
---

# $filename

EOF
  exec nvim '-c normal Go' "$file_path"
}

if [[ $# -eq 1 ]]; then
  filename=$1
else
  require_cmds fzf
  # --print-query prints the typed text first, then the pick (if any), so the
  # last line is the pick, or the typed name when nothing matched
  filename=$(
    find "$ZET_DIR" -maxdepth 1 -type f -name "*.md" \
      -not -name ".*" -not -name "README.md" -not -name "index.md" |
      sed "s|^$ZET_DIR/||; s|\.md$||" | sort |
      fzf --prompt="Search Notes: " --print-query | tail -1
  ) || true
  if [[ -z "$filename" ]]; then
    read -r -p "Enter a filename: " filename
    [[ -n "$filename" ]] || die "No filename entered."
  fi
fi

open_file "$filename"
