#!/usr/bin/env bash
#
# vimcheat: print a cheat sheet of easily forgotten Vim motions.
# (The base script was taken from rwxrob.)

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

[[ "${1:-}" == -h || "${1:-}" == --help ]] && {
  usage
  exit 0
}

# "keys | description" lines, sorted alphabetically. Function text objects:
# aF/iF are treesitter (function definition), af/if are mini.ai (function call).
cheats=$(
  cat <<'CHEATS'
caw  | change around current word
ciw  | change current word
cw   | change to end of current word
daW  | delete around current larger word
daF  | delete current function (definition)
daf  | delete current function call, e.g. foo(a, b)
dap  | delete around current paragraph
daw  | delete around current word
dd   | delete the current line
diW  | delete current larger word (ex: --foo-bar)
diF  | delete current function body
dif  | delete current function call's arguments
dip  | delete current paragraph
diw  | delete current word
dw   | delete to beginning of next word
ea   | append to current word
gqap | wrap around the current paragraph
gqip | wrap the current paragraph
vaF  | select current function, then ]f / [f to move between functions
yaF  | yank current function
yap  | yank around current paragraph
yiF  | yank current function body
yip  | yank current paragraph
>ip  | indent the current paragraph
<ip  | dedent the current paragraph
!ip  | send the current paragraph to shell command
CHEATS
)

line="${YELLOW}---------------------------------------------------------${RESET}"
echo "$line"
while IFS='|' read -r keys desc; do
  printf '%s%-5s%s - %s%s%s\n' "$YELLOW" "${keys% }" "$RED" "$GREEN" "${desc# }" "$RESET"
done <<<"$cheats"
echo "$line"
