#!/usr/bin/env bash
#
# commit: show what will be committed, ask for a message, commit.
#
#   commit             commit the staged files; if nothing is staged, all
#                      tracked changes (`git add -u`)
#   commit <path>...   commit exactly these files (new ones included),
#                      leaving anything else staged untouched
#   commit -a          stage everything first, untracked files included

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  -a | --all)
    shift
    git add -A
    ;;
esac

# With paths, commit exactly those files (untracked ones included) and leave the
# rest of the index untouched.
# Without, a non-empty index means the user staged a subset deliberately (possibly
# with `git add -p`), so commit exactly that; otherwise fall back to all tracked edits.
if [[ $# -gt 0 ]]; then
  git add -- "$@"
  staged=$(git diff --cached --name-only -- "$@")
else
  staged=$(git diff --cached --name-only)

  if [[ -n "$staged" ]]; then
    echo "Using pre-staged files."
    echo ""
  else
    git add -u
    staged=$(git diff --cached --name-only)
  fi
fi

[[ -n "$staged" ]] || die "Nothing to commit."

count=$(echo "$staged" | wc -l | tr -d '[:space:]')
printf '%sStaged (%s):%s\n' "$GREEN" "$count" "$RESET"
printf '%s\n' "$staged" | while IFS= read -r file; do
  printf '  %s%s%s\n' "$GREEN" "$file" "$RESET"
done
echo ""

# With paths, anything else changed (staged or not) is left out. Without, this is
# empty after a `git add -u`, so it only ever prints in the pre-staged case.
if [[ $# -gt 0 ]]; then
  leftout=$({
    git diff --cached --name-only
    git diff --name-only
  } | sort -u | grep -vxF -f <(printf '%s\n' "$staged") || true)
else
  leftout=$(git diff --name-only)
fi
if [[ -n "$leftout" ]]; then
  printf '%sNot committing:%s\n' "$YELLOW" "$RESET"
  printf '%s\n' "$leftout" | while IFS= read -r file; do
    printf '  %s%s%s\n' "$YELLOW" "$file" "$RESET"
  done
  echo ""
fi

read -r -p "Commit message: " commitmessage
[[ -n "$commitmessage" ]] || die "Aborted: empty message."

# `git commit -- <paths>` commits only those paths, ignoring anything else staged.
git commit -m "$commitmessage" -- "$@"
