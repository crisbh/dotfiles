#!/usr/bin/env bash
#
# push: commit (see `commit --help`) and push the current branch.
#
#   push [-a] [path...]   arguments are passed on to `commit`

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

[[ "${1:-}" == -h || "${1:-}" == --help ]] && {
  usage
  exit 0
}

commit "$@"

branch=$(git symbolic-ref --short HEAD)
remote=$(git remote get-url origin)

echo ""
echo "Pushing $branch → $remote"

# -u is idempotent: sets the upstream on the first push, a no-op afterwards
git push -u origin "$branch"
