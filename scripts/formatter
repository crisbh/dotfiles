#!/usr/bin/env bash

# Format all recognised files recursively in the given directory (default: current)
# Usage: formatter [dir]

DIR="${1:-.}"

total=0

run() {
  local cmd="$1"; shift
  if ! command -v "$cmd" &>/dev/null; then
    echo "  skipping: $cmd not installed" >&2
    return 1
  fi
  "$cmd" "$@"
}

while IFS= read -r file; do
  case "$file" in
    *.lua)                echo "  [stylua]        $file"; run stylua "$file"        && total=$((total + 1)) ;;
    *.py)                 echo "  [isort+black]   $file"; run isort -q "$file" && run black -q "$file" && total=$((total + 1)) ;;
    *.c | *.h)            echo "  [clang-format]  $file"; run clang-format -i "$file" && total=$((total + 1)) ;;
    *.cpp | *.hpp | *.cc) echo "  [clang-format]  $file"; run clang-format -i "$file" && total=$((total + 1)) ;;
    *.cu | *.cuh)         echo "  [clang-format]  $file"; run clang-format -i "$file" && total=$((total + 1)) ;;
    *.sh | *.bash)        echo "  [shfmt]         $file"; run shfmt -w "$file"      && total=$((total + 1)) ;;
  esac
done < <(find "$DIR" -type f | sort)

echo ""
echo "done: $total file(s) formatted in $DIR"
