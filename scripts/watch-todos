#!/usr/bin/env bash
#
# watch-todos: collect TODOs from the diary (todo-collect) whenever it
# changes, once edits have settled for 20 seconds. Runs until interrupted.

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

[[ "${1:-}" == -h || "${1:-}" == --help ]] && {
  usage
  exit 0
}

require_cmds fswatch
require_vault

NOTES_DIR="$DIARY_DIR"
SCRIPT_COLLECT="$HOME/.dotfiles/scripts/todo-collect"
DEBOUNCE=20 # seconds of quiet before collecting

echo "🔍 Watching $NOTES_DIR for changes..."

# Debounce: after the first change, keep draining events until none arrives
# for $DEBOUNCE seconds (`read -t` times out), then collect once. -o prints
# only change counts; which files changed does not matter here. todo-collect
# rewrites only the notes it actually changes, so its own edits cause at most
# one extra (no-op) run.
fswatch -o --event Updated "$NOTES_DIR" | while read -r _; do
  while read -r -t "$DEBOUNCE" _; do :; done
  echo "$(date '+%H:%M:%S') Edits settled. Collecting TODOs..."
  bash "$SCRIPT_COLLECT"
done
