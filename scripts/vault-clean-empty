#!/usr/bin/env bash

# Find and interactively delete empty notes from the vault.
# A note is "empty" if it has no content beyond YAML frontmatter,
# blank lines, or a lone markdown heading.

if [[ -z "$VAULT" ]]; then
  echo "❌ \$VAULT is not set." >&2
  exit 1
fi

candidates=()

is_empty() {
  local file="$1"
  local body
  body=$(awk '
    /^---$/ && !seen { seen=1; in_fm=1; next }
    in_fm && /^---$/ { in_fm=0; next }
    in_fm { next }
    { print }
  ' "$file" | grep -vE '^[[:space:]]*$' | grep -vE '^#{1,6} ')
  [[ -z "$body" ]]
}

echo "🔍 Scanning for empty notes..."

while IFS= read -r file; do
  if is_empty "$file"; then
    candidates+=("$file")
  fi
done < <(vault-ls | sort)

if [[ ${#candidates[@]} -eq 0 ]]; then
  echo "✅ No empty notes found."
  exit 0
fi

echo ""
echo "Empty notes (${#candidates[@]}):"
for f in "${candidates[@]}"; do
  echo "  ${f#"$VAULT"/}"
done

echo ""
read -rp "Delete these ${#candidates[@]} file(s)? [y/N] " answer
if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
  echo "Aborted."
  exit 0
fi

deleted=0
for f in "${candidates[@]}"; do
  rm "$f"
  echo "  🗑  deleted: ${f#"$VAULT"/}"
  deleted=$((deleted + 1))
done

echo ""
echo "✅ Deleted $deleted empty note(s)."
