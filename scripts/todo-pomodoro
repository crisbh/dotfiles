#!/usr/bin/env bash
#
# todo-pomodoro: pick a task from active.md and track a pomodoro for it in
# timewarrior, using the task's @tags. A notification fires at the end.
#
#   todo-pomodoro      25 minutes
#   todo-pomodoro 2    50 minutes (double)

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

[[ "${1:-}" == -h || "${1:-}" == --help ]] && {
  usage
  exit 0
}

require_cmds fzf timew
require_vault

TODO_FILE="$ACTIVE_FILE"
tmpfile TEMP_TASKS
tmpfile TEMP_COLORED

# Extract tasks into a selection list
{ grep '^- \[!\]' "$TODO_FILE" || true; } | sed 's/- \[!\] /🔥 /' >"$TEMP_TASKS"
{ grep '^- \[ \]' "$TODO_FILE" || true; } | sed 's/- \[ \] /📄 /' >>"$TEMP_TASKS"

# Add colors for tags using ANSI escape codes
sed -E \
  -e 's/@coding/'"$(printf '\033[1;34m')@coding$(printf '\033[0m')/g" \
  -e 's/@research/'"$(printf '\033[1;32m')@research$(printf '\033[0m')/g" \
  -e 's/@teaching/'"$(printf '\033[1;33m')@teaching$(printf '\033[0m')/g" \
  -e 's/@tracking/'"$(printf '\033[1;31m')@tracking$(printf '\033[0m')/g" \
  -e 's/@admin/'"$(printf '\033[1;35m')@admin$(printf '\033[0m')/g" \
  "$TEMP_TASKS" >"$TEMP_COLORED"

# If no tasks exist, exit
if [ ! -s "$TEMP_TASKS" ]; then
  echo "❌ No tasks found in TODO.md!"
  exit 1
fi

# Let the user pick a task using fzf
SELECTED_TASK=$(fzf --ansi --prompt="Pick a task: " <"$TEMP_COLORED" || true)

if [ -z "$SELECTED_TASK" ]; then
  echo "❌ No task selected!"
  exit 1
fi

# Remove symbols and the tag colour codes added for display
CLEAN_TASK=$(echo "$SELECTED_TASK" | sed -E 's/\x1b\[[0-9;]*m//g; s/^(🔥|📄) //')

# Extract tags directly from the task, one timewarrior tag each
mapfile -t TAGS < <(echo "$CLEAN_TASK" | grep -o '@[a-zA-Z0-9_]\+' | tr -d '@' || true)

if [[ ${#TAGS[@]} -eq 0 ]]; then
  echo "❌ No tags found for this task!"
  echo "Please give it a tag to enable time tracking."
  exit 1
fi

# Remove tags from the task text for display
CLEAN_TASK=$(echo "$CLEAN_TASK" | sed 's/@[a-zA-Z0-9_]\+//g' | xargs)

# Set the duration for the pomodoro. Default is 25 mins
DURATION=1500
POMO_TYPE=""
# If argument 2 is given, run double pomodoro (50 mins).
if [[ ${1:-} == "2" ]]; then
  DURATION=3000
  POMO_TYPE="double "
fi

# Start tracking with Timewarrior
echo "⏳ Starting ${POMO_TYPE}Pomodoro for: \"$CLEAN_TASK\""
echo "📝 Timewarrior tags: ${TAGS[*]}"
timew start "${TAGS[@]}"
STARTED=$(timew get dom.active.start)

# Run in the background and send notification when finished. Only stop the
# interval this pomodoro started: if tracking moved on meanwhile, leave it.
(
  sleep "$DURATION"
  if [[ "$(timew get dom.active 2>/dev/null)" == 1 && "$(timew get dom.active.start)" == "$STARTED" ]]; then
    timew stop >/dev/null
  fi
  pnotify "Focus Session" "Pomodoro Finished!"
) >/dev/null 2>&1 &

echo "✅ ${POMO_TYPE}Pomodoro started!"
