#!/usr/bin/env bash
#
# dotfiles-update: bring this machine up to date with the dotfiles: pull,
# upgrade vault-tools, stow, install the crontab, reload tmux, then run
# dotfiles-doctor.
#
#   dotfiles-update         pull (fast-forward only), stow, crontab (asks first), doctor
#   dotfiles-update --yes   install the crontab without asking
#
# Run it after merging a PR, and on the other machines afterwards. It pulls only
# on main; on another branch it stows and checks what is checked out. Packages
# are not installed: when the Brewfile or packages-fedora.txt changed, it says
# so (run install.sh for those).

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

DOT="${DOTFILES:-$HOME/.dotfiles}"
yes_flag=()
case "${1:-}" in
  "") ;;
  --yes | -y) yes_flag=(--yes) ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "Unknown argument: $1" ;;
esac

step() { printf '\n%s== %s%s\n' "$BOLD" "$1" "$RESET"; }

# ── Pull ──────────────────────────────────────────────────────────────────────
step "Pull"
branch=$(git -C "$DOT" symbolic-ref --short HEAD 2>/dev/null || echo detached)
before=$(git -C "$DOT" rev-parse HEAD)
if [[ "$branch" == main ]]; then
  git -C "$DOT" pull --ff-only || die "Could not fast-forward main: sort it out in $DOT, then re-run."
else
  warn "On $branch, not main: not pulling."
fi
after=$(git -C "$DOT" rev-parse HEAD)
if [[ "$before" == "$after" ]]; then
  echo "No new commits."
else
  git -C "$DOT" log --oneline "$before..$after"
  changed=$(git -C "$DOT" diff --name-only "$before" "$after")
  if grep -qxE 'Brewfile|packages-fedora.txt' <<<"$changed"; then
    warn "The package list changed: run \`bash $DOT/install.sh\` to install packages."
  fi
fi

# ── vault-tools ───────────────────────────────────────────────────────────────
step "vault-tools"
if ! command -v uv >/dev/null; then
  warn "uv is not installed, so vault-tools cannot be updated."
elif uv tool list 2>/dev/null | grep -q '^vault-tools '; then
  GIT_SSH_COMMAND="ssh -o BatchMode=yes" uv tool upgrade vault-tools || warn "Could not upgrade vault-tools."
else
  warn "vault-tools is not installed: uv tool install $VAULT_TOOLS_URL"
fi

# ── Stow ──────────────────────────────────────────────────────────────────────
step "Stow"
bash "$DOT/install.sh" --no-pkgs --yes || die "install.sh failed (see above)."

# ── Cron ──────────────────────────────────────────────────────────────────────
step "Cron"
"$DOT/scripts/dotfiles-cron" --install "${yes_flag[@]}" || warn "The crontab was not updated."

# ── tmux ──────────────────────────────────────────────────────────────────────
if tmux info >/dev/null 2>&1; then
  step "tmux"
  tmux source-file "$HOME/.tmux.conf" && echo "Reloaded ~/.tmux.conf."
fi

# ── Doctor ────────────────────────────────────────────────────────────────────
step "Doctor"
exec "$DOT/scripts/dotfiles-doctor"
