#!/usr/bin/env bash
#
# vault-sync: share the vault through GitHub: run pre-flight checks, commit,
# pull, process tasks (todo collect + todo done), and push. Handles first-time
# git init and remote setup.
#
#   vault-sync             interactive run
#   vault-sync --dry-run   show what would be committed and pulled; change nothing
#   vault-sync --auto      unattended (cron): never prompts, aborts instead
#
# Every machine runs this: each commits its own edits, rebases them onto what
# the others pushed, and pushes. Only what the vault's allow-list .gitignore
# names is shared (0-tasks/, 0-zettelkasten/, templates/); diary/ and the rest
# stay local to each machine. Tasks are processed after the pull, on files that
# already include the other machines' edits, so what is done on one machine
# reaches done.md everywhere.

# No `set -e`: exit codes are checked explicitly below (`$?` after the
# sensitive-content check and `git ls-remote`), and an unattended run must not
# stop silently halfway through a sync.
set -uo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

DRY_RUN=0
AUTO=0
for arg in "$@"; do
  case "$arg" in
    --dry-run | -n) DRY_RUN=1 ;;
    --auto) AUTO=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "Unknown argument: $arg (see vault-sync --help)" ;;
  esac
done

require_vault

# An iCloud vault is the same folder on every Mac: only the Mac with
# ~/.vault-owner runs git in it, or iCloud syncs .git between Macs mid-write.
if [[ "$VAULT" == *"/Mobile Documents/"* && ! -f "$HOME/.vault-owner" ]]; then
  [[ $AUTO -eq 1 ]] && exit 0
  die "The vault is in iCloud and this Mac is not its owner: run vault-sync on the Mac that has ~/.vault-owner."
fi

cd "$VAULT" || {
  echo "❌ Cannot cd into \$VAULT: $VAULT" >&2
  exit 1
}

# ── First-time git setup ──────────────────────────────────────────────────────
if [[ ! -d ".git" ]]; then
  if [[ $AUTO -eq 1 ]]; then
    echo "❌ Git not initialized. Run vault-sync manually first." >&2
    exit 1
  fi
  echo "📦 Initializing git repository in vault..."
  git init -b main
  # Check the URL now: a bare `user/repo` is taken as a local path and only
  # fails later, on every pull and push.
  while :; do
    read -rp "GitHub remote URL, e.g. git@github.com:user/repo.git (blank to skip push): " remote_url
    [[ -z "$remote_url" ]] && break
    if git ls-remote "$remote_url" &>/dev/null; then
      git remote add origin "$remote_url"
      echo "✅ Remote set to $remote_url"
      break
    fi
    echo "❌ Cannot reach $remote_url — check the URL and your SSH key, then try again."
  done

  # Another machine may have pushed already: adopt its history and make sure
  # local files do not silently overwrite the shared ones.
  if [[ -n "$remote_url" ]] && git ls-remote --exit-code --heads origin main &>/dev/null; then
    git fetch origin main
    git reset -q --mixed origin/main
    git branch --set-upstream-to=origin/main main &>/dev/null
    # Files this machine does not have yet just come from GitHub
    git ls-files -z --deleted | xargs -0 -r git checkout --
    differs=$(git status --porcelain --untracked-files=no)
    if [[ -n "$differs" ]]; then
      echo ""
      echo "⚠️  These local files differ from origin/main:"
      while IFS= read -r line; do echo "  $line"; done <<<"$differs"
      echo "   Keep GitHub's version:  git -C \"$VAULT\" checkout -- <paths>"
      echo "   Keep yours:             run vault-sync again to commit and push them"
      exit 1
    fi
    echo "✅ Checked out origin/main"
  fi
fi

# ── Repo state ────────────────────────────────────────────────────────────────
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")
# Every machine shares main; pushing any other branch would publish whatever it
# holds (a stray `master` from an old setup once carried diary notes).
if [[ "$BRANCH" != main ]]; then
  echo "❌ The vault is on branch '$BRANCH'; vault-sync only shares main." >&2
  echo "   Switch to it first, e.g.: git -C \"$VAULT\" switch main" >&2
  exit 1
fi
HAS_REMOTE=0
git remote get-url origin &>/dev/null && HAS_REMOTE=1

# ── Sync conflict check ───────────────────────────────────────────────────────
# iCloud writes "note (conflict 1).md"; Syncthing writes
# "note.sync-conflict-20260101-120000-ABCDEFG.md".
conflicts=$(find "$VAULT" \( -name '* (conflict*' -o -name '*.sync-conflict-*' \) -name '*.md' 2>/dev/null)
if [[ -n "$conflicts" ]]; then
  echo "⚠️  Sync conflict files detected:"
  echo "$conflicts" | sed "s|$VAULT/||" | sed 's/^/  /'
  if [[ $AUTO -eq 0 ]]; then
    read -rp "Continue anyway? [y/N] " answer
    [[ "$answer" != "y" && "$answer" != "Y" ]] && {
      echo "Aborted."
      exit 0
    }
  fi
fi

# ── Pre-flight: clean empty notes ─────────────────────────────────────────────
# echo ""
# echo "=== Step 1/3: Clean empty notes ==="
#vault-clean-empty

# ── Pre-flight: sensitive content check ───────────────────────────────────────
echo ""
echo "=== Step 2/3: Check sensitive content ==="
if [[ $DRY_RUN -eq 1 ]]; then
  vault-check-sensitive --dry-run
else
  vault-check-sensitive
fi
sensitive_exit=$?

if [[ $sensitive_exit -ne 0 ]]; then
  if [[ $AUTO -eq 1 ]]; then
    echo "⚠️  Sensitive files flagged — aborting auto-sync. Run vault-sync manually to review." >&2
    exit 1
  fi
  echo ""
  read -rp "Sensitive files were flagged and added to .gitignore. Continue with sync? [y/N] " answer
  [[ "$answer" != "y" && "$answer" != "Y" ]] && {
    echo "Aborted."
    exit 0
  }
fi

# ── Pre-flight: broken links (informational) ──────────────────────────────────
if [[ $AUTO -eq 0 ]]; then
  echo ""
  echo "=== Step 3/3: Check broken links ==="
  vault-broken-links
fi

# ── Allow-list check ──────────────────────────────────────────────────────────
# Only an allow-list .gitignore (starting with `/*`, see GITIGNORE_TEMPLATE in
# lib/vaultops.py) keeps diary/ and the other local folders out of the commit.
first_rule=$(grep -v -e '^#' -e '^[[:space:]]*$' .gitignore 2>/dev/null | head -n 1)
if [[ "$first_rule" != "/*" ]]; then
  echo "❌ $VAULT/.gitignore is not the allow-list, so local folders would be committed." >&2
  echo "   Start it with the allow-list from GITIGNORE_TEMPLATE in" >&2
  echo "   ${DOTFILES:-$HOME/.dotfiles}/scripts/lib/vaultops.py, then run vault-sync again." >&2
  exit 1
fi

# ── Commit ────────────────────────────────────────────────────────────────────
echo ""
echo "=== Committing ==="
git add -A

if git diff --cached --quiet; then
  echo "ℹ️  Nothing new to commit."
elif [[ $DRY_RUN -eq 1 ]]; then
  echo "🔍 Dry run — staged changes that would be committed:"
  git diff --cached --stat
  git reset HEAD -- . &>/dev/null
else
  MSG="vault: sync $(date '+%Y-%m-%d %H:%M')"
  git commit -m "$MSG"
fi

# ── Pull ──────────────────────────────────────────────────────────────────────
# Runs after the commit so the working tree is clean and the rebase replays local
# vault edits on top of whatever another machine pushed.
HAS_COMMITS=0
git rev-parse --verify HEAD &>/dev/null && HAS_COMMITS=1

if [[ $HAS_REMOTE -eq 1 && $HAS_COMMITS -eq 1 ]]; then
  echo ""
  echo "=== Pulling from origin/$BRANCH ==="
  # --exit-code returns 2 for "no such branch"; anything else non-zero means the
  # remote was unreachable (network down, no SSH key) and must not pass silently.
  git ls-remote --exit-code --heads origin "$BRANCH" &>/dev/null
  ls_remote_exit=$?

  if [[ $ls_remote_exit -eq 2 ]]; then
    echo "ℹ️  origin/$BRANCH does not exist yet — nothing to pull."
  elif [[ $ls_remote_exit -ne 0 ]]; then
    echo "❌ Cannot reach origin (network down or SSH key unavailable)." >&2
    echo "   Skipping pull and push; local commits are safe and will sync next run." >&2
    exit 1
  elif [[ $DRY_RUN -eq 1 ]]; then
    git fetch origin "$BRANCH" &>/dev/null
    incoming=$(git rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)
    echo "🔍 Dry run — $incoming commit(s) would be pulled from origin/$BRANCH."
  elif git pull --rebase --autostash origin "$BRANCH"; then
    echo "✅ Pulled from origin/$BRANCH"
  else
    git rebase --abort &>/dev/null
    echo "❌ Pull failed — conflicting edits between this machine and origin/$BRANCH." >&2
    echo "   The rebase was aborted and nothing was pushed. Resolve manually in:" >&2
    echo "   $VAULT" >&2
    exit 1
  fi
fi

if [[ $DRY_RUN -eq 1 ]]; then
  echo ""
  echo "🔍 Dry run — would run todo collect and todo done."
  echo ""
  echo "ℹ️  Dry run complete. Nothing was committed, pulled, or pushed."
  exit 0
fi

# ── Tasks ─────────────────────────────────────────────────────────────────────
# A failing step must not stop the sync: warn and push what there is.
echo ""
echo "=== Processing tasks ==="
todo collect || warn "todo collect failed — tasks were not collected this run."
todo "done" || warn "todo done failed — completed tasks were not moved this run."
git add -A
if ! git diff --cached --quiet; then
  git commit -m "vault: tasks $(date '+%Y-%m-%d %H:%M')"
  HAS_COMMITS=1
fi

# ── Push ──────────────────────────────────────────────────────────────────────
if [[ $HAS_REMOTE -eq 0 ]]; then
  echo "ℹ️  No remote configured — committed locally only."
elif [[ $HAS_COMMITS -eq 0 ]]; then
  echo "ℹ️  No commits yet — nothing to push."
else
  echo ""
  echo "=== Pushing to origin/$BRANCH ==="
  # Rejected when another machine pushed since the pull: rebase onto it once.
  if ! git push --set-upstream origin "$BRANCH"; then
    echo "ℹ️  Push rejected — pulling again and retrying."
    if ! git pull --rebase --autostash origin "$BRANCH"; then
      git rebase --abort &>/dev/null
      echo "❌ Pull failed — conflicting edits between this machine and origin/$BRANCH." >&2
      echo "   Nothing was pushed. Resolve manually in: $VAULT" >&2
      exit 1
    fi
    if ! git push --set-upstream origin "$BRANCH"; then
      echo "❌ Push failed; local commits are safe and will sync next run." >&2
      exit 1
    fi
  fi
  echo "✅ Pushed to origin/$BRANCH"
fi

echo ""
echo "✅ vault-sync complete."
