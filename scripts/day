#!/bin/bash

today=$(date +"%Y-%m-%d")
tomorrow=$(gdate -d "tomorrow" '+%Y-%m-%d')
yesterday=$(gdate -d "yesterday" '+%Y-%m-%d')
file="$VAULT"'/notes/diary/'$(date +"%Y-%m-%d").md

cd "$VAULT" || exit

new_note() {
	touch "$file"

	cat <<EOF >"$file"
---
id: "$today"
aliases:
  - "$today"
tags:
  - daily-notes
---

# $today

[[$yesterday]] - [[$tomorrow]]

## Today
> One sentence: what would make today a success?

- [ ] 
- [ ] 
- [ ] 

## Notes and log

EOF

}

# If the daily note does not exist, create a new one.
# this uses the test command with the -f flag.
just_created=false
if [ ! -f "$file" ]; then
	echo "File does not exist, creating new daily note."
	new_note
	just_created=true
fi

# Open the daily note. Skip when called with --no-open (e.g. from within Neovim).
# New note: jump to line 15 and enter insert mode.
# Existing note: open normally.
if [[ "$1" != "--no-open" ]]; then
    if $just_created; then
        nvim '+normal 15GzzA' "$file"
    else
        nvim '+normal GzzA' "$file"
    fi
fi
