#!/usr/bin/env bash
#
# day: open today's diary note, creating it from the template if needed.
#
#   day              open the note in Neovim (insert mode, at the end)
#   day --no-open    only make sure the note exists (used from within Neovim)

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

open=1
case "${1:-}" in
  "") ;;
  --no-open) open=0 ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "Unknown argument: $1 (see day --help)" ;;
esac

require_vault

today=$(date +"%Y-%m-%d")
tomorrow=$(pdate "tomorrow" '+%Y-%m-%d')
yesterday=$(pdate "yesterday" '+%Y-%m-%d')
file="$DIARY_DIR/$today.md"

cd "$VAULT"

new_note() {
  mkdir -p "$DIARY_DIR"
  cat <<EOF >"$file"
---
id: "$today"
aliases:
  - "$today"
tags:
  - daily-notes
---

# $today

[[$yesterday]] - [[$tomorrow]]

## Today
> One sentence: what would make today a success?


- [ ] 
- [ ] 
- [ ] 

## Notes and log

EOF

}

# If the daily note does not exist, create a new one.
# this uses the test command with the -f flag.
just_created=false
if [ ! -f "$file" ]; then
  echo "File does not exist, creating new daily note."
  new_note
  just_created=true
fi

# Open the daily note. Skip when called with --no-open (e.g. from within Neovim).
# New note: jump to line 15 and enter insert mode.
# Existing note: open at the end enter insert mode.
if [[ $open -eq 1 ]]; then
  if $just_created; then
    nvim '+normal 15GzzA' "$file"
  else
    nvim '+normal GzzA' "$file"
  fi
fi
