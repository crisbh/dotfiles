#!/usr/bin/env bash
#
# countfiles: count the files under each directory, down to a given depth.
#
#   countfiles [depth]    default depth: 1 (the current directory's children)

set -euo pipefail

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

[[ "${1:-}" == -h || "${1:-}" == --help ]] && {
  usage
  exit 0
}

max_depth=${1:-1}
[[ "$max_depth" =~ ^[0-9]+$ ]] || die "Depth must be a number: $max_depth"

find . -maxdepth "$max_depth" -type d -print0 | sort -z |
  while IFS= read -r -d '' dir; do
    printf '%s: %s\n' "$dir" "$(find "$dir" -type f | wc -l | tr -d '[:space:]')"
  done
