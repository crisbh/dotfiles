#!/usr/bin/env bash
#
# welcome: greeting screen with the date, a calendar and uptime.
# (Taken from TJ DeVries's config repo.)

# shellcheck source=lib/common.sh
source "${DOTFILES:-$HOME/.dotfiles}/scripts/lib/common.sh"

clear
printf '%sHello, %s. Today is: %s%s\n\n' "$YELLOW" "$USER" "$(date)" "$RESET"
if command -v cal >/dev/null; then
  printf '%s' "$GREEN"
  cal
  printf '%s\n' "$RESET"
fi
printf '%sSysinfo: %s%s\n' "$YELLOW" "$(uptime)" "$RESET"
