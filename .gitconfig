[core]
    excludesFile = ~/.gitignore_global
    autocrlf = input
    whitespace = fix
    pager = delta
[push]
    default = current
    autoSetupRemote = true
[pull]
    rebase = true
[rebase]
    autoStash = true
[merge]
    conflictstyle = diff3
[branch]
    sort = -committerdate
[diff]
    tool = nvimdiff
    colorMoved = default
[difftool]
    prompt = false
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[alias]
    s = status
    graph = log --oneline --graph --decorate
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    conflicts = diff --name-only --diff-filter=U
    discard = reset HEAD --hard
    undo = reset HEAD~1 --mixed
    stash-all = stash --include-untracked
    local-branches = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'
    recent-branches = !git branch --sort=-committerdate | head
    authors = !git log --format='%aN <%aE>' | grep -v 'users.noreply.github.com' | sort -u --ignore-case
    aliases = !git config --list | grep alias | cut -c 7-
    whoami = !git config user.name && git config user.email
    # Worktrees (see also scripts/wt)
    wl = worktree list
    wp = worktree prune
    wt = !wt
    # Status of every worktree of this repo
    wstatus = "!git worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}' | while read -r p; do printf \"\\033[33m%s\\033[m\\n\" \"$p\"; git -C \"$p\" status -sb; done"
    # Local branches whose remote was deleted (merged PRs)
    gone = !git fetch -p -q && git branch -vv | awk '/: gone]/{print ($1 == \"+\" || $1 == \"*\") ? $2 : $1}'
    # Rebase onto the latest remote default branch
    sync = !git fetch -q origin && git rebase origin/$(git symbolic-ref --short refs/remotes/origin/HEAD | cut -d/ -f2)
[worktree]
    # `git worktree add ../x feat/x` tracks origin/feat/x when it exists
    guessRemote = true
[fetch]
    # Drop refs of remote branches deleted upstream (feeds `git gone`)
    prune = true
[rerere]
    # Reuse conflict resolutions across rebases
    enabled = true
[include]
    path = ~/.gitconfig.local
