# Claude Code keeps credentials, history, caches and sessions in ~/.claude;
# only track the hand-written config
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md

# Python bytecode (scripts/ is Python too)
__pycache__/

# Local investigation notes, never committed
notes/

# espanso: snippets with personal details, and packages from `espanso install`
.config/espanso/match/personal.yml
.config/espanso/match/packages/
